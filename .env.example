# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your real key never reaches GitHub.

OPENAI_API_KEY=sk-your-key-here

# Optional: which OpenAI model to use (any chat model that supports structured output)
OPENAI_MODEL=gpt-5.4-mini

# Optional: the restaurant the reviews are about (used in prompts and reply sign-offs)
RESTAURANT_NAME=PJ's
RESTAURANT_DESCRIPTION=a Chettinad restaurant with three outlets in Coimbatore, Tamil Nadu
